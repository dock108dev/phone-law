# Synthetic-only defaults. This file contains no deployable secret.
# Application profiles: test, demo; local_dev is for explicit offline tooling.
# Other profiles retain historical/future validation only, not deployable capability.
APP_PROFILE=demo
APP_VERSION=0.1.0
ALLOW_REAL_CALL_DATA=false
REAL_CALL_PROCESSING_AUTHORIZED=false
REAL_DATA_APPROVAL_REFERENCE=
AUTH_MODE=fake
APP_SECRET=demo-placeholder-not-a-deployable-secret
DATABASE_URL=postgresql+psycopg://colacci_demo:local-demo-only-password@db:5432/colacci_demo
OBJECT_STORAGE_BACKEND=local_synthetic
OBJECT_STORAGE_BUCKET=synthetic-only
CALL_SOURCE_ADAPTER=fixture
TRANSCRIBER_ADAPTER=fixture
ANALYZER_ADAPTER=fixture
NOTIFICATION_ADAPTER=noop
MEDIA_TEMP_ROOT=/tmp/colacci-law-slice3a/objects
MANUAL_UPLOAD_ROOT=/tmp/colacci-law-slice4-local/objects
MANUAL_UPLOAD_MANIFEST_PATH=/tmp/colacci-law-slice4-local/synthetic-manifest.json
# HTTP body caps: general JSON 1 MiB; transcript 256 KiB; audio adds 64 KiB
# multipart overhead to MEDIA_MAX_BYTES. Limits also apply to streamed bytes.
MEDIA_MAX_BYTES=20971520
MEDIA_MAX_DURATION_SECONDS=60
AUDIO_RETENTION_DAYS=0
TRANSCRIPT_RETENTION_DAYS=0
ANALYSIS_RETENTION_DAYS=0
AUDIT_RETENTION_DAYS=0
RETENTION_POLICY_APPROVED=false
DEBUG=false
CORS_ORIGINS=["http://localhost:15173"]
TRUSTED_HOSTS=["localhost","127.0.0.1","api","web","testserver"]
FIRM_TIMEZONE=America/New_York
LOG_LEVEL=INFO
