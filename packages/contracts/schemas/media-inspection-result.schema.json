{
  "$defs": {
    "MediaContentType": {
      "enum": [
        "audio/mpeg",
        "audio/mp4",
        "audio/wav",
        "audio/webm",
        "video/mp4"
      ],
      "title": "MediaContentType",
      "type": "string"
    },
    "SupportedMediaFormat": {
      "enum": [
        "mp3",
        "mp4",
        "mpeg",
        "mpga",
        "m4a",
        "wav",
        "webm"
      ],
      "title": "SupportedMediaFormat",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "byte_size": {
      "exclusiveMinimum": 0,
      "title": "Byte Size",
      "type": "integer"
    },
    "channel_count": {
      "maximum": 8,
      "minimum": 1,
      "title": "Channel Count",
      "type": "integer"
    },
    "codec": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$",
      "title": "Codec",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "content_type": {
      "$ref": "#/$defs/MediaContentType"
    },
    "duration_seconds": {
      "exclusiveMinimum": 0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "inspected_at": {
      "format": "date-time",
      "title": "Inspected At",
      "type": "string"
    },
    "media_format": {
      "$ref": "#/$defs/SupportedMediaFormat"
    },
    "sample_rate_hz": {
      "exclusiveMinimum": 0,
      "title": "Sample Rate Hz",
      "type": "integer"
    },
    "schema_version": {
      "const": "media-contracts-v1",
      "default": "media-contracts-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "artifact_id",
    "synthetic",
    "media_format",
    "content_type",
    "byte_size",
    "duration_seconds",
    "sample_rate_hz",
    "channel_count",
    "codec",
    "content_sha256",
    "inspected_at"
  ],
  "title": "MediaInspectionResult",
  "type": "object"
}
