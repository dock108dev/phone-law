{
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "deletion_confirmed": {
      "title": "Deletion Confirmed",
      "type": "boolean"
    },
    "error_class": {
      "anyOf": [
        {
          "const": "MEDIA_DELETION_FAILED",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Class"
    },
    "event_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$",
      "title": "Event Id",
      "type": "string"
    },
    "object_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$",
      "title": "Object Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "schema_version": {
      "const": "media-contracts-v1",
